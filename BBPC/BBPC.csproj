<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>BBPC.EditorExtension</AssemblyName>
    <Product>Baldi's Basics Plus Chinese Pack Support - Plus Level Studio Extension</Product>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>BBPC.EditorExtension</RootNamespace>
    <Nullable>enable</Nullable>
    <BaseOutputPath>Build\</BaseOutputPath>
    <Authors>Baymaxawa</Authors>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Optimize>False</Optimize>
    <IsPublishable>False</IsPublishable>
    <DebugType>Full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <IsPublishable>False</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="BepInEx.BaseLib" Version="5.4.21" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
    <!-- Match the HarmonyX assembly bundled with the supported BepInEx runtime. -->
    <PackageReference Include="HarmonyX" Version="2.9.0" />
    <PackageReference Include="System.ValueTuple" Version="4.6.2" />
    <PackageReference Include="UnityEngine.Modules" Version="2020.3.49" IncludeAssets="compile" />
  </ItemGroup>
  
  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\Dlls\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="BBPC">
      <HintPath>..\Dlls\BBPC.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>..\Dlls\BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="MoonSharp.Interpreter">
      <HintPath>..\Dlls\MoonSharp.Interpreter.dll</HintPath>
    </Reference>
    <Reference Include="mscorlib">
      <HintPath>..\mscorlib.dll</HintPath>
    </Reference>
    <Reference Include="MTM101BaldAPI">
      <HintPath>..\Dlls\MTM101BaldAPI.dll</HintPath>
    </Reference>
    <Reference Include="netstandard">
      <HintPath>..\Dlls\netstandard.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\Dlls\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="PlusLevelStudio"><HintPath>..\Dlls\PlusLevelStudio.dll</HintPath></Reference>
    <Reference Include="PlusStudioLevelFormat"><HintPath>..\Dlls\PlusStudioLevelFormat.dll</HintPath></Reference>
    <Reference Include="PlusStudioLevelLoader"><HintPath>..\Dlls\PlusStudioLevelLoader.dll</HintPath></Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>..\Dlls\Unity.TextMeshPro.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\Dlls\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>..\Dlls\UnityEngine.UI.dll</HintPath>
    </Reference>
  </ItemGroup>
  
</Project>
